# FILE MẪU — KHÔNG dán key vào đây (file này được commit lên git).
# Cách dùng: tạo file mới tên ".env" cùng thư mục, chép 2 dòng dưới vào đó rồi dán key.
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tên máy hiện trong PROGRESS.md (vd. may-nha / may-cong-ty). Mỗi máy đặt khác nhau.
STUDIO_MACHINE=
# Thư mục chung để đồng bộ media (clip/âm thanh không đi qua git), vd. Google Drive for desktop:
# STUDIO_MEDIA_DIR=G:/My Drive/AI-video-media
STUDIO_MEDIA_DIR=
