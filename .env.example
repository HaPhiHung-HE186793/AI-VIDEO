# FILE MẪU — KHÔNG dán key vào đây (file này được commit lên git).
# Cách dùng: tạo file mới tên ".env" cùng thư mục, chép 2 dòng dưới vào đó rồi dán key.
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tên máy hiện trong PROGRESS.md (vd. may-nha-win11 / may-cong-ty-ubuntu). Mỗi máy đặt khác nhau.
STUDIO_MACHINE=
# Nơi đồng bộ media (clip/âm thanh không đi qua git) — xem docs/SYNC_SETUP.md:
STUDIO_MEDIA_DIR=rclone:gdrive:AI-video-media
